{#
    One extension in the result list.

    The compatibility strip is the whole point of the card, so it sits in a fixed
    column that lines up with every other card and with the sticky header above the
    list. That alignment is the feature: "which of these work with 6.7" is answered by
    running an eye down one column, which free-flowing pills made impossible.

    Wording is "declares" and never "works with": the data is the maintainer's own
    constraint, not a test result, and the tier says how much of a promise it is.
#}
<article class="card">
    <div>
        <h2 class="card-title">
            <a href="{{ path('extension_detail', {slug: extension.slug}) }}">{{ extension.label }}</a>
        </h2>
        <span class="card-package">{{ extension.packageName }}</span>
    </div>

    {% if extension.stars > 0 %}
        <span class="card-stars num" title="Stars are shown for context but do not affect ranking">
            {{ extension.stars }} ★
        </span>
    {% endif %}

    {% if supported is defined and supported|length %}
        <div class="card-matrix">
            <div class="matrix" role="list" aria-label="Declared Shopware compatibility">
                {% for version in shopwareVersions %}
                    {% set tier = supported[version.majorMinor] ?? null %}
                    {# A glyph as well as a colour. Colour alone fails WCAG 1.4.1, and
                       "declared" versus "open-ended" is precisely the distinction a
                       reader must not miss. #}
                    <span role="listitem"
                          class="matrix-cell {{ tier == 'explicit' ? 'is-yes' : (tier ? 'is-unverified' : '') }}"
                          title="Shopware {{ version.majorMinor }} — {{ tier == 'explicit'
                              ? 'declared'
                              : (tier ? 'declared, but with an open-ended constraint we cannot verify' : 'not declared') }}">
                        <span aria-hidden="true">{{ tier == 'explicit' ? '●' : (tier ? '◐' : '·') }}</span>
                        <span class="visually-hidden">
                            Shopware {{ version.majorMinor }}:
                            {{ tier == 'explicit' ? 'declared' : (tier ? 'open-ended' : 'not declared') }}
                        </span>
                    </span>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if extension.description %}
        <p class="card-desc">{{ extension.description|length > 190
            ? extension.description|slice(0, 190)|trim ~ '…'
            : extension.description }}</p>
    {% endif %}

    <div class="badges card-badges">
        {{ include('catalog/_badges.html.twig') }}
    </div>
</article>
