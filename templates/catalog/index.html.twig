{% extends 'base.html.twig' %}

{% macro facet_link(criteria, facet, value, label, count, active) %}
    {% set target = active ? criteria.with(facet, null) : criteria.with(facet, value) %}
    <li>
        <a class="{{ active ? 'is-active' : '' }}" href="{{ path('home', target.toQueryParameters) }}"
           {{ active ? 'aria-current="true"' : '' }}>
            <span>{{ label }}</span>
            <span class="count num">{{ count }}</span>
        </a>
    </li>
{% endmacro %}

{% block title %}
    {%- if criteria.query -%}
        {{ criteria.query }} — extdir
    {%- elseif criteria.shopwareVersion -%}
        Shopware {{ criteria.shopwareVersion }} extensions — extdir
    {%- else -%}
        Open-source Shopware 6 extensions — extdir
    {%- endif -%}
{% endblock %}

{% block meta_description %}
    Find open-source Shopware 6 extensions and see which Shopware versions they
    declare support for, whether they are still maintained, and how they are licensed.
{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ url('home', criteria.toCanonicalParameters) }}">
{% endblock %}

{% block og_title %}
    {%- if criteria.shopwareVersion -%}
        Shopware {{ criteria.shopwareVersion }} extensions
    {%- else -%}
        Open-source Shopware 6 extensions
    {%- endif -%}
{% endblock %}
{% block og_description %}{{ result.total }} open-source Shopware 6 extensions, with the versions each declares support for and when the code was last touched.{% endblock %}

{% block structured_data %}
    {{ parent() }}
    {# The results as an ItemList. Only what is on this page — describing 423 items
       on a page showing 24 would be a misrepresentation, and the position numbers
       account for pagination so page two does not claim to start at one. #}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        'name': 'Open-source Shopware 6 extensions',
        'numberOfItems': result.total,
        'itemListElement': result.extensions|map((extension, i) => {
            '@type': 'ListItem',
            'position': ((criteria.page - 1) * 24) + i + 1,
            'name': extension.label,
            'url': url('extension_detail', {slug: extension.slug})
        })
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body %}
<div class="wrap page">

    <div class="page-head">
        <h1>Open-source Shopware 6 extensions</h1>
        <p>
            {{ result.total }} extensions indexed from Packagist. Every entry shows the Shopware
            versions its maintainer <em>declares</em> support for, when the repository was last
            touched, and whether its licence actually permits reuse.
        </p>
    </div>

    <div class="catalog">
        {# On a phone the filter column stacks above the results, and it is long: 40
           links, so the first extension began 1.6 screens down on a directory whose
           entire purpose is browsing extensions.

           Collapsed into a drawer rather than reordered with CSS `order`, which would
           have left a keyboard user tabbing through filters while looking at results.
           The markup ships open, so a browser without JavaScript keeps today's
           behaviour; the controller closes it only on the widths where it is a
           problem. #}
        <aside class="facets" aria-label="Filters" data-controller="facet-drawer">
            <details class="facet-drawer" open data-facet-drawer-target="drawer">
                <summary class="facet-drawer-toggle">
                    Filters{% if criteria.hasFilters %} <span class="chip chip--count">active</span>{% endif %}
                </summary>

                {# Closed here, during parsing, rather than by the controller after
                   hydration. Collapsing it later moved the results column up by 590px
                   *after* first paint — a layout shift of 0.26 on its own, which is
                   most of a failing CLS score, and exactly the kind of jump that makes
                   a page feel broken on a phone.

                   Same trick as the theme script in base.html.twig: it runs before the
                   content below it has been laid out, so nothing ever moves. The
                   markup ships open, so a browser with no JavaScript still shows the
                   filters. #}
                <script>
                    (function (drawer) {
                        try {
                            if (window.matchMedia('(max-width: 900px)').matches) {
                                drawer.open = false;
                            }
                        } catch (e) {
                            /* No matchMedia. Leaving it open is the safe direction. */
                        }
                    })(document.currentScript.parentNode);
                </script>

            {% if criteria.hasFilters %}
                <p class="facet-clear-wrap">
                    <a class="facet-clear" href="{{ path('home', criteria.isCompact ? {view: 'compact'} : {}) }}">Clear all filters</a>
                </p>
            {% endif %}

            {# Each block is rendered only when it has options with results. A facet
               heading with nothing under it — which "Maintenance" was, before
               enrichment ran — reads as a broken page. #}
            {% set versionOptions = [] %}
            {% for version in shopwareVersions|reverse %}
                {% set count = result.facet('shopware')[version.majorMinor] ?? 0 %}
                {% if count > 0 or criteria.shopwareVersion == version.majorMinor %}
                    {% set versionOptions = versionOptions|merge([{
                        value: version.majorMinor,
                        label: version.majorMinor ~ (version.current ? ' · current' : ''),
                        count: count
                    }]) %}
                {% endif %}
            {% endfor %}

            {% if versionOptions|length %}
                <div class="facet">
                    <h2>Shopware version</h2>
                    <ul>
                        {% for option in versionOptions %}
                            {{ _self.facet_link(criteria, 'shopware', option.value, option.label,
                                option.count, criteria.shopwareVersion == option.value) }}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% set maintenanceOptions = [] %}
            {% for state, label in {
                'current': 'Actively maintained',
                'lagging': 'Behind current release',
                'dormant': 'Dormant',
                'abandoned': 'Abandoned'
            } %}
                {% set count = result.facet('maintenance')[state] ?? 0 %}
                {% if count > 0 or criteria.maintenance == state %}
                    {% set maintenanceOptions = maintenanceOptions|merge([{value: state, label: label, count: count}]) %}
                {% endif %}
            {% endfor %}

            {% if maintenanceOptions|length %}
                <div class="facet">
                    <h2>Maintenance</h2>
                    <ul>
                        {% for option in maintenanceOptions %}
                            {{ _self.facet_link(criteria, 'maintenance', option.value, option.label,
                                option.count, criteria.maintenance == option.value) }}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% set licenceOptions = [] %}
            {% for state, label in {
                'permissive': 'Permissive (MIT, Apache…)',
                'copyleft': 'Copyleft (GPL, MPL…)',
                'rejected': 'Not open source',
                'unknown': 'No licence found'
            } %}
                {% set count = result.facet('licence')[state] ?? 0 %}
                {% if count > 0 or criteria.licence == state %}
                    {% set licenceOptions = licenceOptions|merge([{value: state, label: label, count: count}]) %}
                {% endif %}
            {% endfor %}

            {% if licenceOptions|length %}
                <div class="facet">
                    <h2>Licence</h2>
                    <ul>
                        {% for option in licenceOptions %}
                            {{ _self.facet_link(criteria, 'licence', option.value, option.label,
                                option.count, criteria.licence == option.value) }}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% set categoryOptions = [] %}
            {% for key, category in categories %}
                {% set count = result.facet('category')[key] ?? 0 %}
                {% if count > 0 or criteria.category == key %}
                    {% set categoryOptions = categoryOptions|merge([{value: key, label: category.label, count: count}]) %}
                {% endif %}
            {% endfor %}

            {% if categoryOptions|length %}
                {# 28 categories is the longest thing on this page by some margin.
                   Collapsed behind a native <details> so it costs nothing when closed
                   and needs no JavaScript to open. #}
                <div class="facet">
                    <h2>Category</h2>
                    <ul>
                        {% for option in categoryOptions|slice(0, 8) %}
                            {{ _self.facet_link(criteria, 'category', option.value, option.label,
                                option.count, criteria.category == option.value) }}
                        {% endfor %}
                    </ul>

                    {% if categoryOptions|length > 8 %}
                        <details class="facet-more" {{ criteria.category and criteria.category not in categoryOptions|slice(0, 8)|column('value') ? 'open' : '' }}>
                            <summary>{{ categoryOptions|length - 8 }} more categories</summary>
                            <ul>
                                {% for option in categoryOptions|slice(8) %}
                                    {{ _self.facet_link(criteria, 'category', option.value, option.label,
                                        option.count, criteria.category == option.value) }}
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                </div>
            {% endif %}
            </details>
        </aside>

        <div>
            {# Active filters restated where the results are. A tick in the sidebar
               tells you what is selected only if you look at the sidebar; after
               scrolling, a reader has no idea why the list is short. Each token is
               also the way to remove that one filter. #}
            {% if criteria.hasFilters %}
                <div class="tokens">
                    {% if criteria.query %}
                        <a class="token" href="{{ path('home', criteria.with('query', null).toQueryParameters) }}">
                            <span class="token-key">search</span> {{ criteria.query }}
                        </a>
                    {% endif %}
                    {% if criteria.shopwareVersion %}
                        <a class="token" href="{{ path('home', criteria.with('shopware', null).toQueryParameters) }}">
                            <span class="token-key">shopware</span> {{ criteria.shopwareVersion }}
                        </a>
                    {% endif %}
                    {% if criteria.maintenance %}
                        <a class="token" href="{{ path('home', criteria.with('maintenance', null).toQueryParameters) }}">
                            <span class="token-key">maintenance</span> {{ criteria.maintenance }}
                        </a>
                    {% endif %}
                    {% if criteria.licence %}
                        <a class="token" href="{{ path('home', criteria.with('licence', null).toQueryParameters) }}">
                            <span class="token-key">licence</span> {{ criteria.licence }}
                        </a>
                    {% endif %}
                    {% if criteria.category %}
                        <a class="token" href="{{ path('home', criteria.with('category', null).toQueryParameters) }}">
                            <span class="token-key">category</span> {{ categories[criteria.category].label ?? criteria.category }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            <div class="results-head">
                <p class="results-count">
                    {% if criteria.query %}
                        <strong class="num">{{ result.total }}</strong> result{{ result.total == 1 ? '' : 's' }} for
                        <strong>{{ criteria.query }}</strong>
                    {% else %}
                        <strong class="num">{{ result.total }}</strong> extension{{ result.total == 1 ? '' : 's' }}
                    {% endif %}
                </p>

                <div class="results-controls">
                    {# Density, not a filter. Two links rather than a control, so it
                       works without JavaScript and each state has its own URL. #}
                    <div class="view-toggle" role="group" aria-label="Row density">
                        <a href="{{ path('home', criteria.with('view', 'comfortable').toQueryParameters) }}"
                           class="{{ criteria.isCompact ? '' : 'is-active' }}"
                           {{ criteria.isCompact ? '' : 'aria-current="true"' }}>Detailed</a>
                        <a href="{{ path('home', criteria.with('view', 'compact').toQueryParameters) }}"
                           class="{{ criteria.isCompact ? 'is-active' : '' }}"
                           {{ criteria.isCompact ? 'aria-current="true"' : '' }}>Compact</a>
                    </div>

                    <form class="sort-form" method="get" action="{{ path('home') }}">
                        {% for key, value in criteria.toQueryParameters %}
                            {% if key != 'sort' and key != 'page' %}
                                <input type="hidden" name="{{ key }}" value="{{ value }}">
                            {% endif %}
                        {% endfor %}
                        <label for="sort">Sort</label>
                        <select class="select" id="sort" name="sort" onchange="this.form.submit()">
                            {% for value, label in sortLabels %}
                                <option value="{{ value }}" {{ criteria.sort == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                        <noscript><button class="btn btn--sm" type="submit">Apply</button></noscript>
                    </form>
                </div>
            </div>

            {% if result.isEmpty %}
                <div class="empty">
                    <p><strong>Nothing matched those filters.</strong></p>
                    <p class="small">
                        Search terms shorter than three characters are ignored — the database index
                        does not store them.
                    </p>
                    {# Someone staring at an empty result is the one person who knows
                       about an extension we do not. Asking here costs nothing and is
                       the only moment they are certain of the gap. #}
                    <p class="small">
                        Know an extension that should be listed?
                        <a href="{{ path('submission_new') }}">Submit it</a> — it is added
                        straight away if its composer.json says it is a Shopware 6 plugin.
                    </p>
                    <p><a class="link-arrow" href="{{ path('home') }}">Clear filters</a></p>
                </div>
            {% else %}
                <div class="rows {{ criteria.isCompact ? 'rows--compact' : '' }}"
                     role="list" aria-label="Extensions"
                     tabindex="-1">
                    {# Column headers, so every row is read against a label rather than
                       against a legend. They stay put while the list scrolls. #}
                    <div class="rows-head" aria-hidden="true">
                        <span>Extension</span>
                        <span>Declares Shopware</span>
                        <span>Licence</span>
                        <span class="ta-r">Last commit</span>
                        <span></span>
                    </div>

                    {% for extension in result.extensions %}
                        {{ include('catalog/_row.html.twig', {
                            extension: extension,
                            supported: matrices[extension.id] ?? {},
                            shopwareVersions: shopwareVersions,
                            compact: criteria.isCompact
                        }) }}
                    {% endfor %}
                </div>

                {% if result.pageCount > 1 %}
                    <nav class="pagination" aria-label="Pagination">
                        {% if result.hasPreviousPage %}
                            <a rel="prev" href="{{ path('home', criteria.with('page', criteria.page - 1).toQueryParameters) }}">← Previous</a>
                        {% endif %}
                        <span class="num">Page {{ criteria.page }} of {{ result.pageCount }}</span>
                        {% if result.hasNextPage %}
                            <a rel="next" href="{{ path('home', criteria.with('page', criteria.page + 1).toQueryParameters) }}">Next →</a>
                        {% endif %}
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
