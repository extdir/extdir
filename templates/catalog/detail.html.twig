{% extends 'base.html.twig' %}

{% set technicalName = extension.technicalName %}

{% block title %}{{ extension.label }} ({{ extension.packageName }}) — extdir{% endblock %}
{% block meta_description %}{{ extension.description|default(extension.label)|slice(0, 155) }}{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ url('extension_detail', {slug: extension.slug}) }}">
{% endblock %}

{% block og_type %}article{% endblock %}
{% block og_title %}{{ extension.label }} — Shopware 6 extension{% endblock %}
{% block og_description %}{{ extension.description|default(extension.packageName)|slice(0, 180) }}{% endblock %}
{% block og_image %}{{ url('og_extension', {slug: extension.slug}) }}{% endblock %}

{% block structured_data %}
    {{ parent() }}
    {# SoftwareApplication, deliberately not Product. Product triggers Google's
       Merchant Listings parser, which then demands price, availability, shipping and
       returns fields — none of which a directory of free extensions has or should
       invent. The offer is stated as zero-price because that is true and because
       omitting it invites the parser to guess.

       Only facts already on the page go in here. Structured data that says more than
       the visible page is the definition of the markup Google penalises. #}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'SoftwareApplication',
                'name': extension.label,
                'identifier': extension.packageName,
                'url': url('extension_detail', {slug: extension.slug}),
                'applicationCategory': 'BusinessApplication',
                'operatingSystem': 'Shopware 6',
                'description': extension.description|default(extension.label),
                'license': extension.licenseSpdx ? 'https://spdx.org/licenses/' ~ extension.licenseSpdx ~ '.html' : null,
                'codeRepository': extension.repositoryUrl,
                'dateModified': extension.lastCommitAt ? extension.lastCommitAt|date('Y-m-d') : null,
                'author': { '@type': 'Organization', 'name': extension.vendor.name },
                'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'EUR' },
                'isAccessibleForFree': true
            },
            {
                '@type': 'BreadcrumbList',
                'itemListElement': [
                    { '@type': 'ListItem', 'position': 1, 'name': 'Extensions', 'item': url('home') },
                    { '@type': 'ListItem', 'position': 2, 'name': extension.label, 'item': url('extension_detail', {slug: extension.slug}) }
                ]
            }
        ]
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body %}
<div class="wrap page">

    {# A spec sheet. Everything needed to decide — compatibility, licence,
       maintenance, install — resolves without scrolling, and each value says where it
       came from. This is the page an agency developer arrives at from a search
       engine, usually to answer one question and leave. #}
    <header class="detail-head">
        <div class="detail-title-row">
            <span class="ext-icon-lg">{{ include('catalog/_icon.html.twig') }}</span>
            <h1>{{ extension.label }}</h1>
            <span class="detail-package">{{ extension.packageName }}</span>
        </div>

        {% if extension.description %}
            <p class="lead detail-lede">{{ extension.description }}</p>
        {% endif %}

        <div class="spec">
            <div class="spec-item">
                <span class="label spec-key">Declares Shopware</span>
                <div class="spec-value">
                    {% set anyDeclared = false %}
                    {% for version in shopwareVersions %}
                        {% set tier = matrix[version.majorMinor] ?? null %}
                        {% if tier %}
                            {% set anyDeclared = true %}
                            <span class="chip chip--version {{ tier == 'explicit' ? 'is-explicit' : 'is-open' }}"
                                  title="{{ tier == 'explicit'
                                      ? 'Declares support for Shopware ' ~ version.majorMinor
                                      : 'Open-ended constraint covering Shopware ' ~ version.majorMinor }}">
                                {{ version.majorMinor }}{{ tier == 'explicit' ? '' : '˚' }}
                            </span>
                        {% endif %}
                    {% endfor %}
                    {% if not anyDeclared %}
                        <span class="row-none">none parsable</span>
                    {% endif %}
                </div>
                <span class="spec-note">from <code>require</code> in composer.json</span>
            </div>

            <div class="spec-item">
                <span class="label spec-key">Licence</span>
                <div class="spec-value">
                    {% set licence = extension.licenseStatus %}
                    <span class="chip {{ licence.value == 'unknown' or licence.value == 'rejected' ? 'chip--risk' : '' }}">
                        {{ extension.licenseSpdx ?? licence.badgeLabel }}
                    </span>
                </div>
                {# Naming the declared value where the verdict is negative. A reader
                   who sees a repository advertising a "Free license" and a badge
                   saying "not open source" cannot otherwise tell whether the index
                   is wrong or the word "free" means price rather than freedom. The
                   raw string settles it, and puts the disagreement where the
                   maintainer can see it. #}
                <span class="spec-note">
                    {%- if licence.value == 'unknown' -%}
                        no licence file or declaration found — not redistributable
                    {%- elseif licence.value == 'rejected' and extension.declaredLicenseRaw -%}
                        declared <code>{{ extension.declaredLicenseRaw }}</code> in composer.json
                    {%- elseif extension.licenseEvidence.value == 'detector' -%}
                        detected from the LICENSE file
                    {%- else -%}
                        declared in composer.json
                    {%- endif -%}
                </span>
            </div>

            <div class="spec-item">
                <span class="label spec-key">Last commit</span>
                <div class="spec-value">
                    {% if extension.lastCommitAt %}
                        <span class="mono num">{{ extension.lastCommitAt|date('j M Y') }}</span>
                    {% else %}
                        <span class="row-none">unknown</span>
                    {% endif %}
                </div>
                <span class="spec-note">
                    {{ extension.maintenanceStatus.value == 'unknown'
                        ? 'no commit history we can read'
                        : extension.maintenanceStatus.value }}
                </span>
            </div>

            <div class="spec-item">
                <span class="label spec-key">Source</span>
                <div class="spec-value">
                    {% if extension.repositoryUrl %}
                        <a class="link" href="{{ extension.repositoryUrl }}" rel="noopener nofollow">
                            {{ extension.sourceHost.value }}
                        </a>
                    {% else %}
                        <span class="row-none">not recorded</span>
                    {% endif %}
                </div>
                <span class="spec-note">
                    {% if catalogueStatus.crawledAt %}crawled {{ catalogueStatus.crawledAt|ago }} ago{% endif %}
                </span>
            </div>
        </div>

        {% if extension.isOnPackagist %}
            <div class="install">
                <span class="label spec-key">Install</span>
                <div class="install-row">
                    <pre class="code">composer require {{ extension.packageName }}</pre>
                    <button type="button" class="btn btn--sm copy-btn"
                            data-controller="clipboard"
                            data-action="clipboard#copy"
                            data-clipboard-text="composer require {{ extension.packageName }}"
                            aria-label="Copy the composer require command">
                        <span data-copy-label>Copy</span>
                    </button>
                </div>
            </div>
        {% endif %}

        <div class="badges detail-badges">
            {{ include('catalog/_badges.html.twig') }}
        </div>
    </header>

    <div class="detail-grid">
        <div>
            <section class="panel">
                <h2>About that compatibility</h2>
                <p class="small muted">
                    These are the versions the maintainer <strong>declares</strong> support for in
                    <code>composer.json</code>, not versions extdir has tested. A dashed chip marked
                    <code>˚</code> means the constraint is open-ended — for example <code>^6.5</code>,
                    which claims every later
                    6.x release including ones published after the extension was last touched.
                </p>
            </section>

            {% if releases|length %}
            <section class="panel">
                <h2>Releases</h2>
                <div class="table-scroll">
                    <table class="data">
                        <thead>
                        <tr>
                            <th>Version</th>
                            <th>Declared constraint</th>
                            <th>Read from</th>
                            <th>Confidence</th>
                            <th>Released</th>
                            <th>Download</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for release in releases %}
                            <tr>
                                <td class="num">{{ release.versionRaw }}</td>
                                <td><code>{{ release.shopwareConstraint ?? '—' }}</code></td>
                                <td class="small muted">{{ release.constraintSource.value|replace({'shopware/': ''}) }}</td>
                                <td class="small">{{ release.constraintTier.value }}</td>
                                <td class="small muted num">{{ release.releasedAt ? release.releasedAt|date('Y-m-d') : '—' }}</td>
                                <td class="small">
                                    {% if release.distUrl %}
                                        {# The distinction matters: a maintainer's release ZIP was packaged
                                           with shopware-cli and contains built admin/storefront assets. A git
                                           zipball is source only and will not simply install. Saying so is
                                           more useful than a download that fails after unzipping. #}
                                        {% if release.distSource == 'release_asset' %}
                                            <a href="{{ release.distUrl }}" rel="noopener nofollow"
                                               title="Archive published by the maintainer, built with shopware-cli">
                                                ZIP
                                            </a>
                                        {% else %}
                                            <a class="subtle" href="{{ release.distUrl }}" rel="noopener nofollow"
                                               title="Source archive from the git tag. Contains no built administration or storefront assets, so it is not installable as-is — use Composer instead.">
                                                source
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        <span class="subtle">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="small muted stack-sm">
                    The constraint column shows the maintainer's own text, verbatim. If our reading of
                    it looks wrong, this is the value to check it against.
                </p>
            </section>
            {% endif %}

            <section class="panel">
                <h2>Install</h2>

                {% if extension.licenseStatus.isRedistributable %}
                    {% if extension.onPackagist %}
                        <p class="small muted">Available on Packagist:</p>
                        <pre class="code">composer require {{ extension.packageName }}</pre>
                    {% else %}
                        {# Not on Packagist, so a bare `composer require` fails with
                           "could not be found in any version". The Composer surface plan asks for both paths;
                           printing only the first would be actively misleading. #}
                        <p class="small muted">
                            This extension is <strong>not published on Packagist</strong>, so
                            <code>composer require</code> alone cannot find it. Add extdir as a
                            repository once:
                        </p>
                        <pre class="code">composer config repositories.extdir composer https://extdir.com/repo
composer require {{ extension.packageName }}</pre>
                        <p class="small subtle">
                            Or point Composer straight at the source, with no third party involved:
                        </p>
                        <pre class="code">composer config repositories.{{ extension.slug }} vcs {{ extension.repositoryUrl }}
composer require {{ extension.packageName }}</pre>
                    {% endif %}
                {% else %}
                    {# the licence gate: an extension with no usable licence is linked, never
                       redistributed — so no install snippet is offered that would
                       route a merchant through infrastructure we host. #}
                    <p class="small text-danger">
                        No open-source licence was detected for this repository, so extdir does not
                        publish install instructions or host anything for it. Public code is not the
                        same as code you are licensed to redistribute. Contact the maintainer if you
                        need clarity on the terms.
                    </p>
                {% endif %}

                {% if technicalName and extension.licenseStatus.isRedistributable %}
                    <p class="small muted stack">Then activate it:</p>
                    <pre class="code">bin/console plugin:refresh
bin/console plugin:install --activate {{ technicalName }}</pre>
                    <p class="small subtle">
                        The technical name comes from <code>extra.shopware-plugin-class</code> in the
                        package, so this is the actual name to type — not a placeholder.
                    </p>
                {% endif %}
            </section>
        </div>

        <aside>
            <section class="panel">
                <h2>Details</h2>
                <dl class="kv">
                    <dt>Vendor</dt>
                    <dd><a href="{{ path('vendor', {slug: extension.vendor.slug}) }}">{{ extension.vendor.name }}</a></dd>

                    <dt>Licence</dt>
                    <dd>{{ extension.licenseSpdx ?? extension.licenseStatus.badgeLabel }}</dd>

                    {% if technicalName %}
                        <dt>Plugin name</dt>
                        <dd><code>{{ technicalName }}</code></dd>
                    {% endif %}

                    <dt>Last commit</dt>
                    <dd class="num">{{ extension.lastCommitAt ? extension.lastCommitAt|date('Y-m-d') : 'unknown' }}</dd>

                    <dt>Last release</dt>
                    <dd class="num">{{ extension.lastReleaseAt ? extension.lastReleaseAt|date('Y-m-d') : 'unknown' }}</dd>

                    {% if extension.stars > 0 %}
                        <dt>Stars</dt>
                        <dd class="num">{{ extension.stars }}</dd>
                    {% endif %}

                    <dt>Ranking score</dt>
                    <dd class="num">{{ extension.rankScore|number_format(1) }} / 100</dd>
                </dl>
                <p class="small subtle stack-sm">
                    <a href="{{ path('ranking') }}">How this score is calculated</a>
                </p>
            </section>

            <section class="panel">
                <h2>Links</h2>
                <ul class="list-plain small">
                    {% if extension.repositoryUrl %}
                        <li><a href="{{ extension.repositoryUrl }}" rel="noopener nofollow">Source repository →</a></li>
                    {% endif %}
                    <li><a href="https://packagist.org/packages/{{ extension.packageName }}" rel="noopener nofollow">Packagist →</a></li>
                    {% if extension.supportLink %}
                        <li><a href="{{ extension.supportLink }}" rel="noopener nofollow">Support →</a></li>
                    {% endif %}
                    {% if extension.manufacturerLink %}
                        <li><a href="{{ extension.manufacturerLink }}" rel="noopener nofollow">Maintainer →</a></li>
                    {% endif %}
                </ul>
            </section>

            {% if extension.categories|length %}
                <section class="panel">
                    <h2>Categories</h2>
                    <div class="badges">
                        {% for category in extension.categories %}
                            <a class="badge" href="{{ path('home', {category: category.key}) }}">{{ category.label }}</a>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

        </aside>
    </div>

    {# Moved out of the sidebar. Six panels beside three made that column run some
       300px past the content next to it, and the alternatives in particular were
       squeezed into a width that wrapped every reason onto two lines. Full width
       they read as a list rather than as debris. #}
    {% if alternatives is not empty %}
        <section class="panel">
            <h2>Instead of this</h2>
            {{ include('catalog/_alternatives_rail.html.twig') }}
            <p class="small stack-sm">
        <a class="link-arrow" href="{{ path('alternatives', {slug: extension.slug}) }}">Compare all alternatives</a>
            </p>
        </section>
    {% endif %}

    <div class="detail-actions">
        <section class="panel">
            <h2>Do you maintain this?</h2>
            {% if extension.sourceHost.value == 'github' %}
                <p class="small muted">
                Verify with GitHub and you can remove this entry yourself, without waiting on
                anyone. We check whether your account has write access to the repository — your
                access token is used for that one check and never stored.
                </p>
                <p class="small">
                <a class="link-arrow" href="{{ path('auth_github', {extension: extension.slug}) }}">Verify ownership</a>
                </p>
            {% else %}
                {# Not on GitHub, so there is no API to ask about write access. The
                   maintainer publishes a file only someone with write access could
                   publish, and that stands in for the permission check. #}
                <p class="small muted">
                This repository is not on GitHub, so we cannot check write access through an
                API. Instead you publish a small file in the repository — something only
                someone with write access can do — and we fetch it once.
                </p>
                <p class="small">
                <a class="link-arrow" href="{{ path('ownership_verify_file', {slug: extension.slug}) }}">Verify with a file</a>
                </p>
                <p class="small subtle">
                You will be asked to sign in first, so the verification belongs to an account.
                </p>
            {% endif %}
            <p class="small subtle">
                Not the maintainer? A wrong category, an outdated description or a rights
                complaint can be
                <a href="{{ path('complaint_new', {slug: extension.slug}) }}">reported here</a> —
                no account needed. The <a href="{{ path('takedown') }}">takedown and correction
                policy</a> explains what happens next.
            </p>
        </section>
        {# Offered to everyone rather than only to verified maintainers: the badge
           states public facts, and gating it behind verification would mean
           almost nobody ever uses it. #}
        <section class="panel">
            <h2>Badge for your README</h2>
            <p>
                <img src="{{ path('badge', {slug: extension.slug}) }}" alt="Shopware compatibility for {{ extension.label }}" width="130" height="20">
            </p>
            <p class="small muted">Markdown:</p>
            <div class="install-row">
                <pre class="code">[![Shopware]({{ url('badge', {slug: extension.slug}) }})]({{ url('extension_detail', {slug: extension.slug}) }})</pre>
                <button type="button" class="btn btn--sm copy-btn"
                    data-controller="clipboard"
                    data-action="clipboard#copy"
                    data-clipboard-text="[![Shopware]({{ url('badge', {slug: extension.slug}) }})]({{ url('extension_detail', {slug: extension.slug}) }})"
                    aria-label="Copy the badge markdown">
                <span data-copy-label>Copy</span>
                </button>
            </div>
            <p class="small subtle">
                Updates itself when the declared compatibility changes. Cached for an hour.
            </p>
        </section>
    </div>
</div>
{% endblock %}
