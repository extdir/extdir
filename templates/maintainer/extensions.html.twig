{% extends 'base.html.twig' %}

{% block title %}Your extensions — extdir{% endblock %}
{% block canonical %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
<div class="wrap page">
    <div class="page-head">
        <h1>Your extensions</h1>
        <p>
            Extensions whose repository you have write access to. Verification is checked against
            GitHub each time you sign in — we never store your access token.
        </p>
    </div>

    <div class="prose">
        {% if claims is empty %}
            {# A real first-run state rather than a sentence. There are two routes now,
               and which one applies depends on where the code is hosted — something
               the reader knows and we cannot guess from this page. #}
            <div class="empty">
                <p><strong>Nothing verified yet.</strong></p>
                <p class="small">
                    Open an extension you maintain and choose <strong>Verify ownership</strong>.
                </p>
            </div>

            <h2>The two routes</h2>
            <dl class="kv">
                <dt>On GitHub</dt>
                <dd>
                    We ask GitHub whether your account has write access to the repository. Your
                    access token is used for that one check and never stored.
                </dd>
                <dt>Anywhere else</dt>
                <dd>
                    GitLab, Gitea, Bitbucket and self-hosted forges have no API we can ask, so you
                    publish a small file in the repository instead — something only someone with
                    write access can do — and we fetch it once.
                </dd>
            </dl>
        {% else %}
            <div class="table-scroll" tabindex="0">
                <table class="data">
                    <thead>
                    {# The last column holds the remove button. An empty <th> leaves a screen
                       reader announcing the cell with no idea what it is for, so the label is
                       present and only visually hidden — the column heading would be noise
                       above a single button. #}
                    <tr>
                        <th>Extension</th>
                        <th>Verified</th>
                        <th>How</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for claim in claims %}
                        <tr>
                            <td>
                                <a href="{{ path('extension_detail', {slug: claim.extension.slug}) }}">
                                    {{ claim.extension.label }}
                                </a>
                                <br><span class="code-inline">{{ claim.extension.packageName }}</span>
                            </td>
                            <td class="small muted num">{{ claim.verifiedAt|date('Y-m-d') }}</td>
                            <td class="small muted">{{ claim.method.label }}</td>
                            <td>
                                {% if claim.extension.indexStatus.value == 'delisted' %}
                                    <span class="badge badge--danger">Removed</span>
                                {% else %}
                                    {# No reason field: the takedown policy says a maintainer does
                                       not have to justify removal, so asking would turn a right
                                       into a negotiation. #}
                                    <form method="post" action="{{ path('ownership_delist', {slug: claim.extension.slug}) }}"
                                          onsubmit="return confirm('Remove {{ claim.extension.packageName }} from extdir? It will not reappear in a later crawl.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delist' ~ claim.extension.slug) }}">
                                        <button type="submit" class="btn btn--danger btn--sm">
                                            Remove from extdir
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <h2>Something else wrong?</h2>
        <p>
            Categories, descriptions and compatibility are read from your
            <code>composer.json</code>, so correcting them there fixes them here on the next crawl.
            For anything else, see the <a href="{{ path('takedown') }}">takedown and correction
            policy</a>.
        </p>
    </div>
</div>
{% endblock %}
