{% extends 'base.html.twig' %}

{% block title %}Verify {{ extension.label }} - extdir{% endblock %}

{# Not indexable. The page is meaningless without a session and carries a token
   belonging to one account. #}
{% block canonical %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
<div class="wrap page page--narrow">

    <div class="page-head">
        <p class="eyebrow">Ownership verification</p>
        <h1>{{ extension.label }}</h1>
        <p class="code-inline">{{ extension.packageName }}</p>
    </div>

    {% if alreadyVerified %}
        <div class="notice notice--ok">
            <p><strong>This is already verified for your account.</strong></p>
            <p class="small">
                You can manage it from <a href="{{ path('my_extensions') }}">your extensions</a>.
                Running the check again does no harm.
            </p>
        </div>
    {% endif %}

    <div class="prose">
        <p class="lede">
            Hosted on {{ extension.sourceHost.value == 'other' ? 'a forge' :
            extension.sourceHost.value|capitalize }} rather than GitHub, so there is no API to ask
            about write access. Publish a file only someone with write access could publish.
        </p>

        <ol class="steps">
            <li>
                <h2>Create <code>{{ filename }}</code> in the repository root</h2>
                <p class="small muted">With exactly this content:</p>
                <pre class="code" tabindex="0" id="proof">{{ contents }}</pre>
                <p class="small subtle">
                    The token is tied to your account and this extension. It is not a secret:
                    using it still requires the write access being checked.
                </p>
            </li>

            <li>
                <h2>Commit it to the default branch</h2>
                <p class="small muted">
                    We look at <code>main</code> and <code>master</code>. The file must be at the
                    root, not in a subdirectory.
                </p>
            </li>

            <li>
                <h2>Push, then check</h2>
                <p class="small muted">
                    Forges take a moment to serve a newly pushed raw file. If the first attempt
                    fails, wait half a minute.
                </p>

                <form method="post" action="{{ path('ownership_verify_file_check', {slug: extension.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('verify-file' ~ extension.slug) }}">
                    <button type="submit" class="btn btn--primary">Check now</button>
                </form>
            </li>
        </ol>

        <h2>Afterwards</h2>
        <p>
            Once verified you can remove this entry yourself. You may delete the file afterwards;
            the claim is recorded, not re-checked.
        </p>
        <p class="small subtle">
            A wrong category, an outdated description or a rights complaint is covered by the <a
            href="{{ path('takedown') }}">takedown and correction policy</a>, which needs none of
            this.
        </p>
    </div>
</div>
{% endblock %}
