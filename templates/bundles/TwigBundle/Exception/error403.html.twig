{% extends 'base.html.twig' %}

{% block title %}Not permitted — extdir{% endblock %}
{% block canonical %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{#
    A 403 is not a fault.

    The generic error page told anyone who hit this that the server had broken, that
    it had been logged, and that someone would look at it — none of which is true when
    a visitor simply lacks a permission. Worse, it invites a bug report for an
    incident that never happened. A refusal should say what is being refused and what
    would change it.

    Safe to extend the layout, unlike the 500 page: reaching a 403 means the
    application is working correctly.
#}

{% block body %}
<div class="wrap page">
    <div class="error-page">
        <p class="error-code">403</p>

        {% if app.user %}
            <h1>Your account does not have access to this</h1>
            <p class="lead">
                You are signed in as <strong>{{ app.user.login }}</strong>, but this page needs the
                moderator role.
            </p>
            <p class="small subtle error-note">
                Moderation is granted by hand and deliberately cannot be earned — verifying
                ownership of an extension gives you control of that extension, and nothing else.
            </p>
        {% else %}
            <h1>This page needs an identity</h1>
            <p class="lead">Sign in and try again.</p>
            <p><a class="btn btn--primary" href="{{ path('auth_github') }}">Sign in with GitHub</a></p>
        {% endif %}

        <div class="error-links">
            <a class="link-arrow" href="{{ path('home') }}">Browse extensions</a>
            {% if app.user %}<a class="link-arrow" href="{{ path('my_extensions') }}">Your extensions</a>{% endif %}
            <a class="link-arrow" href="{{ path('about') }}">About extdir</a>
        </div>
    </div>
</div>
{% endblock %}
