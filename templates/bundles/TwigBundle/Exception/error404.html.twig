{% extends 'base.html.twig' %}

{% block title %}Page not found - extdir{% endblock %}

{#
    A 404 here is usually one of three things: an extension that was delisted at its
    maintainer's request, a package name typed from memory, or a stale link from
    before a slug changed. All three are better served by a search box than by an
    apology, so this page offers one.

    Nothing on this page touches the database. A 404 is cheap and common, crawlers
    generate them constantly, and a template that ran a query would turn every bad
    URL into database load. The generic error page goes further and avoids this
    layout entirely; see error.html.twig for why.
#}

{% block body %}
<div class="wrap page">
    <div class="error-page">
        <p class="error-code">404</p>
        <h1>That page is not here</h1>
        <p class="lede">
            It may have been removed at its maintainer's request, or the address changed.
            Searching usually finds it.
        </p>

        <form class="error-search" action="{{ path('home') }}" method="get" role="search">
            <label class="visually-hidden" for="error-q">Search extensions</label>
            <input class="input" id="error-q" type="search" name="q" placeholder="Search extensions" autocomplete="off">
            <button class="btn btn--primary" type="submit">Search</button>
        </form>

        <div class="error-links">
            <a class="link-arrow" href="{{ path('home') }}">Browse everything</a>
            <a class="link-arrow" href="{{ path('ranking') }}">How ranking works</a>
            <a class="link-arrow" href="{{ path('about') }}">About extdir</a>
        </div>

        <p class="small subtle error-note">
            Maintainers can remove their own extensions. Removals are permanent; a delisted entry
            does not return in a later crawl.
        </p>
    </div>
</div>
{% endblock %}
