{% extends 'base.html.twig' %}

{% block title %}Boards - who builds and who uses Shopware 6 extensions - extdir{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('boards') }}">{% endblock %}
{% block meta_description %}Which vendors maintain the most open-source Shopware 6 extensions, which ship the most releases, and which extensions are installed most.{% endblock %}
{% block og_title %}Who builds and who uses open-source Shopware 6 extensions{% endblock %}
{% block og_description %}Six leaderboards over the whole indexed catalogue, each with the rule that produced it.{% endblock %}

{% block body %}
<div class="wrap page">
    <div class="page-head">
        <h1>Boards</h1>
        <p>
            Six leaderboards over the whole indexed catalogue. Each prints the rule behind it,
            so you can check it rather than trust it.
        </p>
    </div>

    <div class="prose">
        <h2>Who builds the ecosystem</h2>
        <p>
            "Most contributing" has three honest meanings and they disagree, so here are all
            three. No winner is declared.
        </p>
    </div>

    <div class="board-grid">
        {% for board in vendorBoards %}
            {% include 'pages/_board.html.twig' with {board: board} only %}
        {% endfor %}
    </div>

    <div class="prose">
        <h2>What people install</h2>
        <p>
            Read the two install boards together. A lifetime total only accumulates, so it
            rewards age as much as use. The thirty-day board cannot.
        </p>
        <p class="notice notice--info">
            <strong>{{ coverage.measured }} of {{ coverage.total }} listed extensions are on Packagist.</strong>
            The rest have no install count at all, so absence here means unmeasured, not unpopular.
        </p>
    </div>

    <div class="board-grid">
        {% for board in extensionBoards %}
            {% include 'pages/_board.html.twig' with {board: board} only %}
        {% endfor %}
    </div>

    <div class="prose">
        <p class="muted">
            Installs and stars appear here and nowhere in the score.
            <a href="{{ path('ranking') }}">How ranking works</a> covers why.
        </p>
    </div>
</div>
{% endblock %}
