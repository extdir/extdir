<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}extdir - open-source Shopware 6 extensions{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}A community-run directory of open-source Shopware 6 extensions, with compatibility and maintenance data.{% endblock %}">
    {% block canonical %}{% endblock %}

    {# Open Graph and Twitter. Pages default to a site-level card; the extension
       page overrides all four with its own. Without these, every link shared into
       Slack or a forum renders as a bare URL, which for a directory whose whole
       job is being passed between colleagues is a wasted introduction. #}
    <meta property="og:site_name" content="extdir">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{% block og_title %}Open-source Shopware 6 extensions{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Which Shopware versions an extension declares support for, whether anyone still maintains it, and what its licence actually permits.{% endblock %}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{% block og_image %}{{ url('og_default') }}{% endblock %}">
    <meta name="twitter:card" content="summary_large_image">

    {% block structured_data %}
        {# WebSite with SearchAction, so a search box can appear under the result in
           Google. Emitted once, on every page, because the site-level graph is the
           same everywhere. #}
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            'name': 'extdir',
            'url': url('home'),
            'description': 'A community-run directory of open-source Shopware 6 extensions.',
            'potentialAction': {
                '@type': 'SearchAction',
                'target': { '@type': 'EntryPoint', 'urlTemplate': url('home') ~ '?q={search_term_string}' },
                'query-input': 'required name=search_term_string'
            }
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
    {% endblock %}

    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    {# The two font faces used above the fold. Without the hint they are only
       discovered once the stylesheet has parsed, which is a visible reflow on a
       cold load. #}
    <link rel="preload" href="{{ asset('fonts/geist-sans-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/geist-mono-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    {# Applied before the first paint, and therefore inline and synchronous.
       A module from the importmap is deferred, so restoring the choice there
       would paint the wrong theme first and then correct it, a white flash on
       every navigation for anyone who chose dark. That flash is the whole reason
       this cannot be a Stimulus controller.

       Only 'light' and 'dark' are ever written; anything else, including a
       cleared choice, falls through to the CSS media query. #}
    <script>
        (function () {
            try {
                var choice = localStorage.getItem('extdir-theme');
                if (choice === 'light' || choice === 'dark') {
                    document.documentElement.setAttribute('data-theme', choice);
                }
            } catch (e) {
                /* Private mode, or storage disabled. The system preference still
                   applies, so there is nothing to recover from. */
            }
        })();
    </script>
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body data-controller="shortcuts remote-media">
<a class="skip-link" href="#main">Skip to content</a>

{% set route = app.request.attributes.get('_route') %}

<header class="site-header">
    {# Two tiers. Search is the primary action on a directory and was previously
       sharing one row with five navigation links at the same visual weight. #}
    <div class="wrap masthead">
        <a class="brand" href="{{ path('home') }}">
            <img class="brand-icon" src="{{ asset('images/favicon.svg') }}" alt="" width="22" height="22">
            <span class="brand-mark">ext<b>dir</b></span>
        </a>

        <form class="header-search" action="{{ path('home') }}" method="get" role="search">
            <label class="visually-hidden" for="header-q">Search extensions</label>
            <input class="input" id="header-q" type="search" name="q" placeholder="Search extensions"
                   value="{{ app.request.query.get('q') }}" autocomplete="off"
                   data-shortcuts-target="search">
            {# The hint is the affordance. A shortcut nobody can see is a shortcut
               nobody uses, and this reader expects one to exist. #}
            <kbd class="kbd" aria-hidden="true">/</kbd>
            <button class="btn btn--primary" type="submit">Search</button>
        </form>

        {# Provenance in the chrome, where the sceptic looks first. Stating how current
           the data is before being asked is most of the trust argument, and a
           directory that hides its crawl age is asking to be taken on faith. #}
        <div class="header-meta">
            {% if catalogueStatus is defined and catalogueStatus.total > 0 %}
                <p class="data-status {{ catalogueStatus.stale ? 'is-stale' : '' }}"
                   title="{{ catalogueStatus.stale
                       ? 'The last successful crawl is older than two days.'
                       : 'Refreshed from Packagist and the source forges.' }}">
                    <span class="num">{{ catalogueStatus.total }}</span> extensions
                    {%- if catalogueStatus.crawledAt %}

                        {# "today old" is what a naive suffix produces, and the filter is
                           terse on purpose for the results column. #}
                        · updated {{ catalogueStatus.crawledAt|ago_phrase }}
                    {%- endif %}
                </p>
            {% endif %}
        </div>
    </div>

    <div class="header-nav-bar">
        <div class="wrap header-nav-inner">
            <nav class="header-nav" aria-label="Main">
                <a href="{{ path('home') }}" class="{{ route == 'home' ? 'is-current' : '' }}">Extensions</a>
                <a href="{{ path('boards') }}" class="{{ route == 'boards' ? 'is-current' : '' }}">Boards</a>
                <a href="{{ path('ranking') }}" class="{{ route == 'ranking' ? 'is-current' : '' }}">Ranking</a>
                <a href="{{ path('about') }}" class="{{ route == 'about' ? 'is-current' : '' }}">About</a>
                {% if app.user %}
                    <a href="{{ path('my_extensions') }}" class="{{ route == 'my_extensions' ? 'is-current' : '' }}">Your extensions</a>
                    {% if is_granted('ROLE_MODERATOR') %}
                        <a href="{{ path('moderate') }}" class="{{ route starts with 'moderate' ? 'is-current' : '' }}">Moderate</a>
                    {% endif %}
                    <a href="{{ path('logout') }}">Sign out</a>
                {% endif %}
            </nav>

            <div class="header-nav-end">
                {# Three states, not two. "System" is the default and has to remain
                   reachable, or someone who tries the toggle can never get back to
                   following their machine. #}
                <div class="theme-toggle" data-controller="theme" role="group" aria-label="Colour theme">
                    <button type="button" class="theme-btn" data-action="theme#choose" data-theme-value="system"
                            data-theme-target="button" aria-pressed="false" title="Follow the system setting">
                        Auto
                    </button>
                    <button type="button" class="theme-btn" data-action="theme#choose" data-theme-value="light"
                            data-theme-target="button" aria-pressed="false" title="Always light">
                        Light
                    </button>
                    <button type="button" class="theme-btn" data-action="theme#choose" data-theme-value="dark"
                            data-theme-target="button" aria-pressed="false" title="Always dark">
                        Dark
                    </button>
                </div>

                {# The trademark rule requires this from day one and on every page, so it
                   lives in the chrome rather than in a strip that could be dismissed or
                   scrolled past. #}
                <p class="header-disclaimer">Not affiliated with Shopware AG · a community project</p>
            </div>
        </div>
    </div>
</header>

<main id="main">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="wrap"><p class="flash flash--{{ type }}">{{ message }}</p></div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div>
            <p class="footer-brand">extdir</p>
            <p class="muted small">
                A community-run directory of open-source Shopware 6 extensions.
            </p>
            <p class="muted small">
                Not affiliated with or endorsed by Shopware AG. "Shopware" is used descriptively.
            </p>
        </div>

        <div>
            <p class="footer-heading">Directory</p>
            <ul>
                <li><a href="{{ path('home') }}">Browse extensions</a></li>
                <li><a href="{{ path('ranking') }}">How ranking works</a></li>
                <li><a href="{{ path('vendors') }}">Vendors</a></li>
                <li><a href="{{ path('about') }}">About the project</a></li>
                <li><a href="{{ path('submission_new') }}">Submit an extension</a></li>
            </ul>
        </div>

        <div>
            <p class="footer-heading">Legal</p>
            <ul>
                {# "Impressum" stays untranslated: it is the term German visitors look for,
                   and the page it names is a German legal obligation. #}
                <li><a href="{{ path('imprint') }}">Impressum</a></li>
                <li><a href="{{ path('privacy') }}">Datenschutz / Privacy</a></li>
                <li><a href="{{ path('terms') }}">Terms</a></li>
                <li><a href="{{ path('takedown') }}">Takedown policy</a></li>
            </ul>
        </div>

        <div>
            <p class="footer-heading">Source</p>
            <ul>
                <li><a href="https://github.com/extdir" rel="noopener">extdir on GitHub</a></li>
            </ul>
            <p class="muted small">
                The platform is open source, so you can inspect how the data was produced.
            </p>
        </div>
    </div>

    <div class="wrap footer-base">
        <p class="powered-by">
            Powered by <a href="https://runio.dev" rel="noopener">runio.dev</a>
            <span class="subtle">operator and maintainer</span>
        </p>
        {# Off by default, and withdrawable. Consent that cannot be taken back is not
           consent, so both directions are one click from every page. The server always
           renders the "off" wording and the controller corrects it on connect, the reverse would flash a false claim to anyone who has not opted in. #}
        <p class="powered-by remote-media-control">
            <span class="subtle" data-remote-media-target="status">
                Extension icons and screenshots are not loaded from their forges.
            </span>
            <button type="button" class="btn btn--sm"
                    data-remote-media-target="enable"
                    data-action="remote-media#allow">Show images</button>
            <button type="button" class="btn btn--sm" hidden
                    data-remote-media-target="disable"
                    data-action="remote-media#revoke">Stop loading images</button>
            <a href="{{ path('privacy') }}">What this shares</a>
        </p>
    </div>
</footer>
</body>
</html>
