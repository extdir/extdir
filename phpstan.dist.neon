parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/

    excludePaths:
        # Generated by Symfony purely for IDE config autocompletion. It is never
        # executed, and its type aliases only resolve while the container cache
        # happens to be warm — so analysing it makes the result depend on whether
        # someone ran cache:clear, which is not a useful signal.
        - config/reference.php

    # Lets PHPStan resolve service types from the real container instead of
    # guessing at autowired constructor arguments.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    # Teaches PHPStan the entity mappings, so repository return types and
    # getArrayResult() shapes are checked rather than treated as mixed.
    doctrine:
        objectManagerLoader: tests/object-manager.php
