# extdir scheduled work. Install with: crontab deploy/cron/crontab
#
# Times are deliberately off-peak and staggered. Packagist and GitHub are being
# asked for a few hundred requests; doing that politely costs nothing and being
# rate-limited costs a day of freshness.

MAILTO=""
EXTDIR=$HOME/websites/extdir

# Shopware release timeline. Rarely changes, but everything downstream depends on
# it: the compatibility matrix columns and every maintenance status are measured
# against these dates.
17 3 * * 1   cd $EXTDIR && php bin/console app:shopware:sync-versions >> $HOME/logs/extdir-cron.log 2>&1

# Package metadata from Packagist. Cheap and the primary source of truth.
23 3 * * *   cd $EXTDIR && php bin/console app:ingest:packagist >> $HOME/logs/extdir-cron.log 2>&1

# Extensions published to GitHub but never to Packagist. Weekly is enough — a
# repository that was never submitted to Packagist is not moving fast.
41 4 * * 2   cd $EXTDIR && php bin/console app:ingest:github >> $HOME/logs/extdir-cron.log 2>&1

# Repository signals, then maintenance status and ranking. Must follow ingestion,
# so it runs well after it rather than in parallel.
11 5 * * *   cd $EXTDIR && php bin/console app:signals:refresh >> $HOME/logs/extdir-cron.log 2>&1

# Download locations. Needs the licence status that enrichment has just settled,
# since an unlicensed extension is never offered a maintainer archive.
47 5 * * *   cd $EXTDIR && php bin/console app:distribution:resolve >> $HOME/logs/extdir-cron.log 2>&1

# Categories, recomputed from stored data. Seconds, no network.
13 6 * * *   cd $EXTDIR && php bin/console app:taxonomy:classify >> $HOME/logs/extdir-cron.log 2>&1

# Database backup, kept for 14 days.
30 2 * * *   $EXTDIR/deploy/backup.sh >> $HOME/logs/extdir-backup.log 2>&1
