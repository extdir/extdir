# extdir scheduled work.
#
# APPEND these lines to the existing crontab — never `crontab deploy/cron/crontab`.
# That form replaces the whole crontab, and this account also schedules work for
# other sites. Installing this file the obvious way would silently delete them:
#
#   (crontab -l; cat deploy/cron/crontab) | crontab -
#
# Paths are absolute and the interpreter is /usr/bin/php83, because cron runs with
# a minimal PATH where `php` is either missing or an older default.
#
# Times are deliberately off-peak and staggered. Packagist and GitHub are being
# asked for a few hundred requests; doing that politely costs nothing and being
# rate-limited costs a day of freshness.

EXTDIR=$HOME/websites/extdir.com

# Optional: dead-man's-switch monitoring. /health notices staleness after 48
# hours, which is the right threshold for "the data is untrustworthy" but a slow
# way to learn that last night's crawl died. Appending a ping to each job tells
# you which one failed, within minutes.
#
#   HC_INGEST=https://hc-ping.com/<uuid>
#   ... && curl -fsS -m 10 --retry 3 $HC_INGEST > /dev/null

# Shopware release timeline. Rarely changes, but everything downstream depends on
# it: the compatibility matrix columns and every maintenance status are measured
# against these dates.
17 3 * * 1   cd $EXTDIR && /usr/bin/php83 bin/console app:shopware:sync-versions >> $HOME/logs/extdir-cron.log 2>&1

# Package metadata from Packagist. Cheap and the primary source of truth.
23 3 * * *   cd $EXTDIR && /usr/bin/php83 bin/console app:ingest:packagist >> $HOME/logs/extdir-cron.log 2>&1

# Extensions published to GitHub but never to Packagist. Weekly is enough — a
# repository that was never submitted to Packagist is not moving fast.
41 4 * * 2   cd $EXTDIR && /usr/bin/php83 bin/console app:ingest:github >> $HOME/logs/extdir-cron.log 2>&1

# Repository signals, then maintenance status and ranking. Must follow ingestion,
# so it runs well after it rather than in parallel.
11 5 * * *   cd $EXTDIR && /usr/bin/php83 bin/console app:signals:refresh >> $HOME/logs/extdir-cron.log 2>&1

# Download locations. Needs the licence status that enrichment has just settled,
# since an unlicensed extension is never offered a maintainer archive.
47 5 * * *   cd $EXTDIR && /usr/bin/php83 bin/console app:distribution:resolve >> $HOME/logs/extdir-cron.log 2>&1

# Categories, recomputed from stored data. Seconds, no network.
13 6 * * *   cd $EXTDIR && /usr/bin/php83 bin/console app:taxonomy:classify >> $HOME/logs/extdir-cron.log 2>&1

# Database backup, kept for 14 days.
30 2 * * *   $EXTDIR/deploy/backup.sh >> $HOME/logs/extdir-backup.log 2>&1
